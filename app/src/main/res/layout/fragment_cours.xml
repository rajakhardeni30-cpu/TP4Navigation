<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mes cours 📚"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#30304D"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Retrouvez vos matières et informations"
            android:textSize="15sp"
            android:textColor="#777777"/>

        <!-- Carte 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Développement mobile"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#663399"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Professeur : Mr Ahmed"
                android:textSize="15sp"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salle : 3"
                android:textSize="15sp"
                android:textColor="#444444"/>

            <Button
                android:id="@+id/btnDetailsMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Voir les détails"
                android:textColor="#FFFFFF"
                android:backgroundTint="#663399"/>
        </LinearLayout>

        <!-- Carte 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💻 Développement Web"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#663399"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Professeur : Mme Salma"
                android:textSize="15sp"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salle : 12"
                android:textSize="15sp"
                android:textColor="#444444"/>

            <Button
                android:id="@+id/btnDetailsWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Voir les détails"
                android:textColor="#FFFFFF"
                android:backgroundTint="#663399"/>
        </LinearLayout>

        <!-- Carte 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗄️ Bases de données"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#663399"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Professeur : Mme Ines"
                android:textSize="15sp"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salle : 5"
                android:textSize="15sp"
                android:textColor="#444444"/>

            <Button
                android:id="@+id/btnDetailsBD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Voir les détails"
                android:textColor="#FFFFFF"
                android:backgroundTint="#663399"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>