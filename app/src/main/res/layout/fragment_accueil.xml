<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F3FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bienvenue à ISAE Campus 🎓"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#663399"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Votre espace universitaire"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#663399"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bienvenue sur ISAE Campus, votre espace numérique dédié à la vie universitaire. Retrouvez facilement vos cours, consultez votre emploi du temps et suivez vos informations académiques dans un seul endroit."
        android:textSize="17sp"
        android:textColor="#444444"
        android:gravity="center"
        android:lineSpacingExtra="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apprendre, organiser et réussir ensemble."
        android:textSize="16sp"
        android:textStyle="italic"
        android:textColor="#663399"
        android:gravity="center"
        android:layout_marginTop="25dp" />

</LinearLayout>