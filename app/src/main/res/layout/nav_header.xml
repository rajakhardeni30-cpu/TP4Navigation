<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1D4ED8"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageProfil"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:contentDescription="Photo de profil"
        android:scaleType="centerCrop"
        android:src="@drawable/photo_profil"
        app:shapeAppearanceOverlay="@style/ImageRonde" />

    <TextView
        android:id="@+id/textApplication"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textEtudiant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BC3"
        android:textColor="#D9EAF7"
        android:textSize="40sp" />

</LinearLayout>
